# 3M1C -- HSV2 UL1: conservation and epitope mapping
# generated by step22_structure_mapping.py on 2026-11-21
load ../pdb/3M1C.pdb, 3M1C
hide everything
show surface, 3M1C
bg_color white
set surface_quality, 1
set transparency, 0.1
color grey80, 3M1C

select variable_sites, chain B and resi 28+32+131

select conserved_within_type, chain B and resi 

select conserved_both_types, chain B and resi 

# known_iedb_epitopes: none

select shortlisted_candidates, chain B and resi 

# positively_selected: none


color salmon, variable_sites
color palecyan, conserved_within_type
color deepteal, conserved_both_types
color yellow, known_iedb_epitopes
color orange, shortlisted_candidates
color red, positively_selected
show sticks, positively_selected

set ray_opaque_background, 0
orient
png 3M1C_UL1_conservation.png, width=2400, height=1800, dpi=300, ray=1
